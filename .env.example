# HyperSync API token (https://envio.dev/app/api-tokens). Required.
ENVIO_API_TOKEN=

# Optional overrides. Slots, not block heights. The start defaults to "latest"
# (the chain head at first deploy).
# ENVIO_START_SLOT=449674151
# ENVIO_END_SLOT=

# Hours of Transfer rows to keep before they are pruned (default 6, fractions
# allowed). Per-minute TransferSummary rows are kept forever.
# ENVIO_RETENTION_HOURS=6

# Minutes of chain time between prunes (default 1). The same rows get deleted
# either way; a longer interval means fewer but larger delete batches.
# ENVIO_PRUNE_INTERVAL_MINUTES=1
